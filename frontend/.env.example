# Frontend environment (Vite). Copy to `.env` and adjust.
# These are PUBLIC client-side vars (safe to expose in the browser).

# Supabase project credentials (public anon key). Leave BOTH blank to run in
# dev bypass mode (no real auth; pair with backend DISABLE_AUTH=true).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# FastAPI backend base URL. Its backend CORS_ALLOWED_ORIGINS must contain this
# frontend's actual browser origin (not this API URL).
VITE_API_BASE_URL=http://localhost:8000
