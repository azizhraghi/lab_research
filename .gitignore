field_readings.csv

# Runtime state written by the app, not source. data/researchers.json holds the
# legacy JSON-backed profiles (the DB-backed /api/biblio/researchers is the real
# store); cvs/ holds generated PDFs. Both are recreated on demand.
data/
cvs/

