# Backend configuration template — copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored and must never be committed.
# Loaded by shared/config.py (pydantic-settings), which reads `.env` then
# `.env.supabase.local`. Frontend vars live separately in frontend/.env.example.

PROJECT_NAME=Laboratoire de Recherche, Sciences et Technologies des Eaux
VERSION=1.0.0

# ── Database ─────────────────────────────────────────────────────────
# Dev default is SQLite. pgvector features (veille dedup + RAG) require
# Postgres — on SQLite the code silently falls back to an in-memory cosine
# loop, so dedup behaviour differs between dev and prod.
DATABASE_URL=sqlite+aiosqlite:///./multiagent.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/multiagent

# ── LLM ──────────────────────────────────────────────────────────────
# Required. Powers veille tagging/summarisation, qualité evaluation and
# orchestrateur routing. Get one at https://console.mistral.ai
MISTRAL_API_KEY=your-mistral-api-key-here

# ── Event bus ────────────────────────────────────────────────────────
# memory | redis | kafka. Read once at import time by create_event_bus().
# NOTE: "memory" dispatches synchronously inside the publishing coroutine and
# does not survive a restart. Redis publish failures are swallowed silently.
EVENT_BUS_TYPE=memory
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Schema ───────────────────────────────────────────────────────────
# Dev convenience: create all tables on startup. Keep False in production and
# use `alembic upgrade head` instead.
CREATE_SCHEMA_ON_STARTUP=true

# ── Auth ─────────────────────────────────────────────────────────────
# DEVELOPMENT ONLY. When true, get_current_user returns a stub user with the
# `administrator` role and skips Supabase validation entirely — every endpoint
# becomes unauthenticated. MUST be false in any deployed environment.
DISABLE_AUTH=true

# Supabase credentials may live here or in `.env.supabase.local`.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Optional: bibliometrie ───────────────────────────────────────────
# Google Scholar via ScraperAPI. Unset = direct Scholar requests (rate-limited).
# Never hardcode this in a source file — it is a metered, billable credential.
# SCRAPER_API_KEY=your-scraperapi-key
