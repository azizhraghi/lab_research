# Backend configuration template — copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored and must never be committed.
# Loaded by shared/config.py (pydantic-settings), which reads `.env` then
# `.env.supabase.local`. Frontend vars live separately in frontend/.env.example.

PROJECT_NAME=Laboratoire de Recherche, Sciences et Technologies des Eaux
VERSION=1.0.0
# development | test | staging | production. Production rejects unsafe defaults
# during startup rather than quietly accepting a local-development configuration.
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────
# Dev default is SQLite. Indexed pgvector dedup requires
# Postgres — on SQLite the code uses an in-memory cosine
# loop, so dedup behaviour differs between dev and prod.
DATABASE_URL=sqlite+aiosqlite:///./multiagent.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/multiagent

# ── LLM ──────────────────────────────────────────────────────────────
# Required for scientific-watch embeddings, tagging and summaries.
# Core project and water workflows use deterministic rules without Mistral.
# Get a key at https://console.mistral.ai
MISTRAL_API_KEY=your-mistral-api-key-here

# ── Event bus ────────────────────────────────────────────────────────
# memory | redis | kafka. Read once at import time by create_event_bus().
# NOTE: "memory" is development-only and does not survive a restart. Redis
# publish failures are retained in the database outbox and retried.
EVENT_BUS_TYPE=memory
# Durable delivery retries. A failed event becomes visible in /operations/outbox.
OUTBOX_POLL_SECONDS=1
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_SECONDS=2
OUTBOX_CLAIM_SECONDS=30
# Automatic collection cadence. In a multi-replica deployment enable the
# internal scheduler on only one API worker, or use an external scheduler.
VEILLE_SCHEDULER_ENABLED=true
VEILLE_COLLECTION_INTERVAL_HOURS=24
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Schema ───────────────────────────────────────────────────────────
# Dev convenience: create all tables on startup. Keep False in production and
# use `alembic upgrade head` instead.
CREATE_SCHEMA_ON_STARTUP=true

# ── Auth ─────────────────────────────────────────────────────────────
# DEVELOPMENT ONLY. When true, get_current_user returns a stub user with the
# `administrator` role and skips Supabase validation entirely — every endpoint
# becomes unauthenticated. MUST be false in any deployed environment.
DISABLE_AUTH=true

# Per-device credential pepper for the field gateway. Change to a long unique
# secret before deployment; it is used only to hash gateway tokens at rest.
GATEWAY_TOKEN_PEPPER=development-only-change-me
# A gateway that has not contacted the API within this period is shown offline.
SENSOR_STALE_AFTER_HOURS=48

# Supabase credentials may live here or in `.env.supabase.local`.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Browser origins permitted to call the API. In deployment use the exact
# address of the hosted frontend, for example https://portal.lrste.example.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# When true, startup fails if any required agent cannot start. Production always
# behaves this way regardless of this development/staging setting.
STRICT_AGENT_STARTUP=false

# ── Optional: bibliometrie ───────────────────────────────────────────
# Google Scholar via ScraperAPI. Unset = direct Scholar requests (rate-limited).
# Never hardcode this in a source file — it is a metered, billable credential.
# SCRAPER_API_KEY=your-scraperapi-key
